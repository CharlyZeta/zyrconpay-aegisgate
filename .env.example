# AegisGate — development environment variables
# Copy to `.env` (ignored by git) and adjust. Never commit a real `.env`.
#
# VAULT_TOKEN
#   Root token of the local HashiCorp Vault dev server.
#   - docker/docker-compose.yml reads it as `${VAULT_TOKEN:-dev-root-token-change-me}`
#     for `VAULT_DEV_ROOT_TOKEN_ID`.
#   - aegisgate-ingress / aegisgate-orchestrator read it as `${VAULT_TOKEN:...}` for
#     `spring.cloud.vault.token`.
#   - scripts/setup-vault-mock-secrets.sh reads the same fallback.
#   Keep all four in sync, or the services will fail Vault authentication.
#   In every non-local environment this MUST be overridden (Vault AppRole / K8s auth).
VAULT_TOKEN=dev-root-token-change-me
